        "---\n",
        "title: \"Predicting Student Dropout Risk with Neural Networks\"\n",
        "description: \"Student dropout prediction using progressively enriched multi-stage data as an example of neural network performance evaluation.\"\n",
        "date: \"2025-10-20\"\n",
        "categories: [\"Machine Learning\", \"Neural Networks\", \"Predictive Analytics\", \"Python\"]\n",
        "image: \"../assets/student_dropout/figures/learning_curve_nn_s3.png\"\n",
        "featured: true\n",
        "jupyter: python3\n",
        "page-layout: full\n",
        "bibliography: ../assets/student_dropout/references/references.bib\n",
        "format:\n",
        "  html:\n",
        "    include-in-header:\n",
