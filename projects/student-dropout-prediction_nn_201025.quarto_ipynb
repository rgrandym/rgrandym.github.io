        "    print(f\"Model {i+1} - {config['layers']} layers, {config['units']} units:\")\n",
        "    print(f\"  Validation Accuracy: {result['val_accuracy']:.4f}\")\n",
        "    print(f\"  Final Epochs: {len(result['history'].history['loss'])}\")\n",
        "    print()"
